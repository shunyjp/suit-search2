# Database (SQLite by default - no setup needed)
# DATABASE_URL=sqlite+aiosqlite:///./suitfinder.db

# LLM (Gemini) - required for size extraction from images/text
GEMINI_API_KEY=your-gemini-api-key

# Yahoo Japan Auction Search API
# Register at: https://e.developer.yahoo.co.jp/register
# Required for search() method (web scraping is blocked by Yahoo bot detection)
YAHOO_AUCTION_APP_ID=your-yahoo-app-id

# Browser settings
BROWSER_HEADLESS=true
LOG_LEVEL=INFO
